# Guardia Digital Inteligente — plantilla de variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.

# --- Lambda / Auth0 Log Stream (/lambdas, /infra) ---
# Secreto compartido para validar el webhook (header Authorization: Bearer ...)
AUTH0_WEBHOOK_SECRET=

# --- AWS (/infra) ---
# sa-east-1 (São Paulo) por defecto: latencia/residencia LATAM. Ver infra/variables.tf
AWS_REGION=sa-east-1

# --- Modal -> Vertex AI (/ia_models) ---
GCP_PROJECT=
VERTEX_ENDPOINT_ID=
VERTEX_REGION=us-central1

# --- Datadog: SIEM (/monitoring) + ingesta de logs pendientes (/ia_models) ---
DD_API_KEY=
# Application Key (distinto del API Key): lo exige la Logs Search API v2
# que usa _fetch_pending_logs() en ia_models/anomaly_detector.py
DD_APP_KEY=
DD_SITE=datadoghq.com

# --- Auth0 Management API (/ia_models) ---
# Application M2M autorizada para la Management API (scopes: read:users update:users).
# Usada por _enforce_auth0_response() para cerrar el lazo: fuerza re-MFA o bloquea
# la cuenta cuando Vertex AI detecta un acceso anómalo.
AUTH0_DOMAIN=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Intercom (/support) ---
INTERCOM_APP_ID=

# --- SCAN-SIGHT I.A. (/auth0) ---
# Opcional: URL base del scanner de superficie de ataque (otro producto Wayweb).
# Si se omite, el Action usa la API pública por defecto.
SCAN_SIGHT_API=
